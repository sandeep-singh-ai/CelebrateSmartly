# Copy to .env and fill in your own project keys. Do not commit .env.

VITE_APP_URL=http://localhost:8080

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Email (Brevo). Required for invitations.
VITE_BREVO_API_KEY=your_brevo_api_key

# Optional: local vendor search
VITE_GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Optional: vendor image uploads. Prefer a server-side upload instead of a browser key.
VITE_AWS_ACCESS_KEY_ID=
VITE_AWS_SECRET_ACCESS_KEY=
VITE_AWS_BUCKET_NAME=
VITE_AWS_REGION=us-east-1
